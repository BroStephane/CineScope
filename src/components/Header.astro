---
import { navItems } from '../lib/navItems';

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-40 hidden items-center justify-between border-b border-white/10 bg-bg/80 px-8 py-4 backdrop-blur md:flex">
  <a href="/" class="font-display text-xl">CineScope</a>
  <nav class="flex gap-6 text-sm text-white/70" aria-label="Navigation principale">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={currentPath === item.href ? 'text-white' : 'hover:text-white'}
        aria-current={currentPath === item.href ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
