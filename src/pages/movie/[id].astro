---
// This route's content is entirely client-fetched from TMDB (movie ids are
// unknown at build time, so a static getStaticPaths() list isn't possible).
// Opt it out of prerendering so Astro serves it on-demand via the Vercel
// adapter instead of requiring a full static path list.
export const prerender = false;

import Layout from '../../components/Layout.astro';
import MovieDetail from '../../islands/MovieDetail';

const { id } = Astro.params;
const movieId = Number(id);
---
<Layout title="Film">
  <MovieDetail client:load movieId={movieId} />
</Layout>
